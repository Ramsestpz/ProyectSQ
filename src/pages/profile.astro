---
import Layout from '../layouts/Layout.astro';
import pool from '../lib/db';
import { Auth } from '../lib/auth';

const userId = Auth.getUserFromRequest(Astro.request);

if (!userId) {
    return Astro.redirect('/login');
}

// Fetch user data including new fields
const [userRows]: any[] = await pool.query('SELECT name, email, avatar_url, goal, created_at FROM users WHERE id = ?', [userId]);
const user = userRows[0];

// Fetch simple stats
const [mealCountRows]: any[] = await pool.query('SELECT COUNT(*) as count FROM meals WHERE user_id = ?', [userId]);
const mealCount = mealCountRows[0].count;

const [groceryCountRows]: any[] = await pool.query('SELECT COUNT(*) as count FROM grocery_items WHERE user_id = ?', [userId]);
const groceryCount = groceryCountRows[0].count;

// Fetch latest weight from daily_stats
const [statsRows]: any[] = await pool.query('SELECT weight FROM daily_stats WHERE user_id = ? ORDER BY date DESC LIMIT 1', [userId]);
const currentWeight = statsRows.length > 0 ? statsRows[0].weight : null;

// Mock streak for now
const streak = 5;

const goalLabels: Record<string, string> = {
    'lose_weight': 'Perder Peso',
    'maintain': 'Mantenerse',
    'gain_muscle': 'Ganar Músculo'
};
---

<Layout title="NutriPlan - Mi Perfil">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 overflow-hidden mb-8">
            <div class="bg-orange-500 h-32 relative">
                <div class="absolute -bottom-12 left-8">
                    <div class="w-24 h-24 bg-white rounded-full p-1 shadow-md overflow-hidden">
                        {user.avatar_url ? (
                            <img src={user.avatar_url} alt={user.name} class="w-full h-full object-cover rounded-full bg-gray-100" />
                        ) : (
                            <div class="w-full h-full bg-orange-100 rounded-full flex items-center justify-center text-4xl font-serif font-bold text-orange-500">
                                {user.name ? user.name[0].toUpperCase() : user.email[0].toUpperCase()}
                            </div>
                        )}
                    </div>
                </div>
            </div>
            <div class="pt-16 pb-8 px-8 flex justify-between items-start">
                <div>
                    <h1 class="text-3xl font-serif font-bold text-gray-900">{user.name || 'Usuario'}</h1>
                    <p class="text-gray-500">{user.email}</p>
                    <div class="flex items-center gap-3 mt-3">
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                            {goalLabels[user.goal] || 'Objetivo no definido'}
                        </span>
                        {currentWeight && (
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                {currentWeight} kg
                            </span>
                        )}
                        <span class="text-xs text-gray-400">Miembro desde {new Date(user.created_at).toLocaleDateString('es-ES')}</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                <div class="text-gray-500 text-sm font-medium uppercase mb-1">Racha Actual</div>
                <div class="text-3xl font-bold text-orange-500">{streak} días</div>
                <p class="text-xs text-gray-400 mt-2">¡Sigue así!</p>
            </div>
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                <div class="text-gray-500 text-sm font-medium uppercase mb-1">Comidas Planeadas</div>
                <div class="text-3xl font-bold text-gray-900">{mealCount}</div>
                <p class="text-xs text-gray-400 mt-2">Recetas guardadas</p>
            </div>
            <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
                <div class="text-gray-500 text-sm font-medium uppercase mb-1">Lista de Compras</div>
                <div class="text-3xl font-bold text-gray-900">{groceryCount}</div>
                <p class="text-xs text-gray-400 mt-2">Artículos pendientes</p>
            </div>

        </div>

        <div class="bg-white rounded-3xl shadow-sm border border-gray-100 p-8">
            <h2 class="text-xl font-bold text-gray-900 mb-6">Configuración de la Cuenta</h2>
            <form class="space-y-6 max-w-lg">
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Nombre Completo</label>
                    <input type="text" value={user.name || ''} disabled class="w-full px-4 py-2 rounded-xl border border-gray-200 bg-gray-50" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Correo Electrónico</label>
                    <input type="email" value={user.email} disabled class="w-full px-4 py-2 rounded-xl border border-gray-200 bg-gray-50" />
                </div>
                <div class="pt-4">
                    <button type="button" class="text-red-500 text-sm font-medium hover:text-red-600 transition-colors">
                        Eliminar mi cuenta
                    </button>
                </div>
            </form>
        </div>
    </div>
</Layout>
